  "observations": [
    {"id": "o01", "engagement": "e1", "date": "2025-02-18", "anchor": "seat", "seat": "vp-finance", "function": "sow",
     "text": "Calder's delegation of authority: any consulting SOW over 150,000 dollars is signed by the VP Finance."},
    {"id": "o02", "engagement": "e1", "date": "2025-03-04", "anchor": "seat", "seat": "coo", "function": "steer",
     "text": "The COO chairs Calder's network steering committee and can veto any change to the site network."},
    {"id": "o03", "engagement": "e1", "date": "2025-03-04", "anchor": "seat", "seat": "head-of-ops", "function": "sites",
     "text": "The Head of Operations runs Calder's six sites day to day; every site data request goes through that office."},
    {"id": "o04", "engagement": "e2", "date": "2026-01-27", "anchor": "seat", "seat": "it-director", "function": "wms",
     "text": "Nothing touches Calder's WMS without the IT Director's change board."},
    {"id": "o05", "engagement": "e2", "date": "2026-02-20", "anchor": "seat", "seat": "vp-finance", "function": "sow",
     "text": "Dana Okafor, as VP Finance, signed the Phase 2 SOW for 280,000 dollars."},

    {"id": "o10", "engagement": "e1", "date": "2025-03-11", "anchor": "person", "person": "dana", "trait": "style",
     "text": "Dana Okafor asked for the downside case before she would look at the upside."},
    {"id": "o11", "engagement": "e1", "date": "2025-05-27", "anchor": "person", "person": "dana", "trait": "style",
     "text": "Dana Okafor sent the network model back until the downside case came first."},
    {"id": "o12", "engagement": "e2", "date": "2026-02-10", "anchor": "person", "person": "dana", "trait": "stance", "stance": "champion",
     "text": "Dana Okafor took Phase 2 through Calder's investment committee herself. She is our champion."},
    {"id": "o13", "engagement": "e2", "date": "2026-02-12", "anchor": "person", "person": "dana", "trait": "style",
     "text": "Dana Okafor wanted the savings shown as a downside, base and upside range, downside on top."},
    {"id": "o20", "engagement": "e1", "date": "2025-04-08", "anchor": "person", "person": "marcus", "trait": "stance", "stance": "skeptic",
     "text": "Marcus Hale has been skeptical of warehouse automation since the 2024 sorter failure at the Dunmore site."},
    {"id": "o21", "engagement": "e1", "date": "2025-06-20", "anchor": "person", "person": "marcus", "trait": "style",
     "text": "Marcus Hale vetoed the automated sorter recommendation at the June steering committee."},
    {"id": "o30", "engagement": "e1", "date": "2025-03-19", "anchor": "person", "person": "ines", "trait": "style",
     "text": "Ines Duarte wants site-level throughput data before she will discuss any recommendation."},
    {"id": "o31", "engagement": "e1", "date": "2025-06-20", "anchor": "person", "person": "ines", "trait": "stance", "stance": "supporter",
     "text": "Ines Duarte backed the automated sorter recommendation at the June steering committee."},
    {"id": "o40", "engagement": "e2", "date": "2026-01-27", "anchor": "person", "person": "tom", "trait": "stance", "stance": "neutral",
     "text": "Tom Becker is neutral on scope; what he cares about is that integrations go through his change board."},
    {"id": "o41", "engagement": "e2", "date": "2026-01-29", "anchor": "person", "person": "tom", "trait": "style",
     "text": "Tom Becker needs a written change request two weeks before any WMS change."}
